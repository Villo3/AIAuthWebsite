# Optional: canonical public origin used by metadata.
NEXT_PUBLIC_SITE_URL=

# Optional: product sign-in URL. Without it, Sign in scrolls to the developer section.
NEXT_PUBLIC_APP_URL=

# Optional: server-side endpoint that receives validated access-request JSON.
# Without it, the form opens a prefilled email to ACCESS_REQUEST_EMAIL.
ACCESS_REQUEST_WEBHOOK_URL=
ACCESS_REQUEST_WEBHOOK_SECRET=
ACCESS_REQUEST_EMAIL=hello@boundary.dev

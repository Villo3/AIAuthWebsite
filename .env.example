# Copy to .env.local for local development. NEVER commit real values.

# Production canonical origin used by page metadata.
NEXT_PUBLIC_SITE_URL=https://boundaryxyz.vercel.app

# Product sign-in destination. Without it, Sign in scrolls to Developers.
NEXT_PUBLIC_APP_URL=

# Formspree endpoint for validated access requests. Create a form at
# https://formspree.io, copy its endpoint (https://formspree.io/f/XXXXXX),
# and set ACCESS_REQUEST_WEBHOOK_URL in Vercel (Settings → Environment Variables)
# for Production and Preview. FAKE placeholder — replace before use.
ACCESS_REQUEST_WEBHOOK_URL=https://formspree.io/f/mock-test-id

# Optional bearer secret sent only from the serverless route to Formspree.
ACCESS_REQUEST_WEBHOOK_SECRET=